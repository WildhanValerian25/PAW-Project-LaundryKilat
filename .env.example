# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).

# PostgreSQL (Week 8)
DB_USER=postgres
DB_PASSWORD=isi_password_postgres
DB_HOST=localhost
DB_NAME=laundry_db
DB_PORT=5432

# AI Assistant (Week 9) - pilih "gemini" atau "claude"
AI_PROVIDER=gemini

# Google Gemini - buat API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

