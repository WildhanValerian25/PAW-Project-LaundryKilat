<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof judul !== 'undefined' ? judul : 'Laundry Kilat - Manajemen Layanan' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-700 font-sans pb-20">
    
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-8 py-4 flex justify-between items-center shadow-sm">
        <div class="text-xl font-bold text-blue-600">Laundry Kilat</div>
    </header>

    <main class="max-w-6xl mx-auto mt-10 px-5">
        <section class="mb-16">
            <h2 class="text-2xl font-bold text-slate-800 mb-6">Manajemen Layanan Laundry (CRUD)</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Form Tambah / Edit -->
                <div class="col-span-1 bg-white p-6 rounded-xl border border-slate-200 shadow-sm h-fit">
                    <h3 id="formTitle" class="font-bold text-lg mb-4 text-blue-600">Tambah Layanan Baru</h3>
                    
                    <form id="crudForm" class="flex flex-col gap-3">
                        <input type="hidden" id="crudId">
                        
                        <div>
                            <label class="text-xs font-semibold text-slate-500">Nama Layanan</label>
                            <input type="text" id="crudNama" placeholder="Contoh: Cuci Komplit" class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" required>
                        </div>

                        <div>
                            <label class="text-xs font-semibold text-slate-500">Kategori</label>
                            <input type="text" id="crudKategori" placeholder="Contoh: Kiloan / Satuan / Kilat" class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" required>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="text-xs font-semibold text-slate-500">Harga (Rp)</label>
                                <input type="number" id="crudHarga" placeholder="8000" class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" required>
                            </div>
                            <div>
                                <label class="text-xs font-semibold text-slate-500">Satuan</label>
                                <input type="text" id="crudSatuan" placeholder="kg / pcs / pasang" class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" required>
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-semibold text-slate-500">Estimasi</label>
                            <input type="text" id="crudEstimasi" placeholder="Contoh: 2 hari" class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" required>
                        </div>

                        <div>
                            <label class="text-xs font-semibold text-slate-500">Deskripsi</label>
                            <textarea id="crudDeskripsi" placeholder="Deskripsi singkat layanan..." class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-200 focus:outline-none" rows="2"></textarea>
                        </div>
                        
                        <div class="flex gap-2 mt-2">
                            <button type="submit" class="flex-1 bg-blue-600 text-white py-2 rounded text-sm font-semibold hover:bg-blue-700 transition">Simpan</button>
                            <button type="button" onclick="resetForm()" class="flex-1 bg-slate-200 text-slate-700 py-2 rounded text-sm font-semibold hover:bg-slate-300 transition">Batal</button>
                        </div>
                    </form>
                </div>

                <!-- Grid Data Layanan Laundry -->
                <div class="col-span-2">
                    <div id="product-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
                </div>
            </div>
        </section>
    </main>

    <script>
        const API_URL = '/api/produk';
        const crudForm = document.getElementById('crudForm');
        
        // READ - Mengambil dan Menampilkan Data
        async function fetchProducts() {
            const container = document.getElementById('product-container');
            try {
                const res = await fetch(API_URL);
                const products = await res.json();
                container.innerHTML = '';

                products.forEach(p => {
                    container.innerHTML += `
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-blue-50 text-blue-600">${p.kategori || 'Umum'}</span>
                                    <span class="text-xs text-slate-400">⏱️ ${p.estimasi || '-'}</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-800 mb-1">${p.nama}</h3>
                                <p class="text-xs text-slate-500 mb-4 line-clamp-2">${p.deskripsi || '-'}</p>
                            </div>

                            <div>
                                <div class="text-lg font-bold text-blue-600 mb-3">
                                    Rp ${Number(p.harga).toLocaleString('id-ID')} <span class="text-xs font-normal text-slate-400">/ ${p.satuan}</span>
                                </div>

                                <div class="flex gap-2 border-t pt-3 border-slate-100">
                                    <button onclick="editProduct(${p.id}, '${escapeQuotes(p.nama)}', '${escapeQuotes(p.kategori)}', ${p.harga}, '${escapeQuotes(p.satuan)}', '${escapeQuotes(p.estimasi)}', '${escapeQuotes(p.deskripsi)}')" class="flex-1 text-xs bg-amber-50 text-amber-700 py-1.5 rounded font-medium hover:bg-amber-100 transition">Edit</button>
                                    <button onclick="deleteProduct(${p.id})" class="flex-1 text-xs bg-red-50 text-red-600 py-1.5 rounded font-medium hover:bg-red-100 transition">Hapus</button>
                                </div>
                            </div>
                        </div>
                    `;
                });
            } catch (err) {
                console.error("Gagal load data", err);
                container.innerHTML = '<p class="text-red-500 text-sm">Gagal memuat data dari server.</p>';
            }
        }

        function escapeQuotes(str) {
            if (!str) return '';
            return String(str).replace(/'/g, "\\'");
        }

        // CREATE & UPDATE
crudForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('crudId').value;
    const payload = {
        nama: document.getElementById('crudNama').value,
        kategori: document.getElementById('crudKategori').value,
        harga: parseFloat(document.getElementById('crudHarga').value),
        satuan: document.getElementById('crudSatuan').value,
        estimasi: document.getElementById('crudEstimasi').value,
        deskripsi: document.getElementById('crudDeskripsi').value
    };

    const method = id ? 'PUT' : 'POST';
    const endpoint = id ? `${API_URL}/${id}` : API_URL;

    try {
        const response = await fetch(endpoint, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            const errData = await response.json();
            alert(`Gagal menyimpan data: ${errData.error || response.statusText}`);
            return;
        }

        resetForm();
        fetchProducts(); // Refresh Grid Data
    } catch (err) {
        alert(`Terjadi kesalahan jaringan: ${err.message}`);
    }
});

        // Setup Form untuk EDIT
        function editProduct(id, nama, kategori, harga, satuan, estimasi, deskripsi) {
            document.getElementById('formTitle').textContent = "Edit Layanan";
            document.getElementById('crudId').value = id;
            document.getElementById('crudNama').value = nama;
            document.getElementById('crudKategori').value = kategori;
            document.getElementById('crudHarga').value = harga;
            document.getElementById('crudSatuan').value = satuan;
            document.getElementById('crudEstimasi').value = estimasi;
            document.getElementById('crudDeskripsi').value = deskripsi || '';
        }

        // DELETE
        async function deleteProduct(id) {
            if (confirm('Yakin ingin menghapus layanan ini?')) {
                await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
                fetchProducts();
            }
        }

        function resetForm() {
            crudForm.reset();
            document.getElementById('crudId').value = '';
            document.getElementById('formTitle').textContent = "Tambah Layanan Baru";
        }

        fetchProducts();
    </script>
</body>
</html>